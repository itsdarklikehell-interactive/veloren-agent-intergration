# Runs the Flask dashboard for the headless Veloren agent.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VELOREN_DASHBOARD_HOST=0.0.0.0 \
    VELOREN_DASHBOARD_PORT=5000

WORKDIR /app

# Install dependencies first (better layer caching).
# COPY ... . places the file at /app/requirements.txt (WORKDIR), so the -r
# path must not repeat the web/ prefix.
COPY web/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the whole repo: web/, templates/, static/ plus scripts the dashboard may call.
COPY . .

EXPOSE 5000

# app.py reads VELOREN_DASHBOARD_HOST / VELOREN_DASHBOARD_PORT / DASHBOARD_API_KEY
# from the environment (.env is injected via env_file in docker-compose.yml).
CMD ["python3", "web/app.py"]
