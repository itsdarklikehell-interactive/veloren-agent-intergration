+/// Wrapper to make `Dispatcher` `Send + Sync`.
+/// Safe as long as all systems added to the dispatcher are `Send` (they are in Veloren).
+struct SendDispatcher(Dispatcher<'static, 'static>);
+
+unsafe impl Send for SendDispatcher {}
+unsafe impl Sync for SendDispatcher {}
+
+impl Deref for SendDispatcher {
+    type Target = Dispatcher<'static, 'static>;
+    fn deref(&self) -> &Self::Target {
+        &self.0
+    }
+}
+
+impl DerefMut for SendDispatcher {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.0
+    }
+}
