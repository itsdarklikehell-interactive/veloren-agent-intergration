# Veloren agent credentials
# Copy this file to .env and fill in your values.
# Never commit .env with real credentials — it is gitignored.

# --- Veloren account credentials (used by src/main.rs) ---

# Veloren account username (defaults to --character if not set)
VELOREN_USERNAME=hermes

# Veloren account password (required for authenticated servers)
VELOREN_PASSWORD=your-password-here

# --- Server configuration (used by scripts/start-server.sh, docs/architecture.md) ---

# Path to the veloren-server-cli binary (Airshipper default)
VELOREN_SERVER_BIN=~/.local/share/airshipper/profiles/default/veloren-server-cli

# TCP port the dedicated server listens on
VELOREN_PORT=14004

# --- Agent configuration (used by scripts/hermes-bridge.sh, docs/architecture.md) ---

# Path to the built veloren-agent binary
VELOREN_AGENT_BIN=./target/release/veloren-agent

# Character name the agent plays in the game world
VELOREN_AGENT_CHARACTER=hermes

# --- Asset path (required for headless client; Airshipper default) ---
VELOREN_ASSETS=/home/rizzo/.local/share/airshipper/profiles/default/assets

# --- Web dashboard (used by web/app.py) ---

# API key required on every API endpoint except GET / and GET /api/health.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Printed at startup if unset; set explicitly for production deployments.
DASHBOARD_API_KEY=

# Dashboard bind address and port (defaults: 127.0.0.1:5000)
VELOREN_DASHBOARD_HOST=127.0.0.1
VELOREN_DASHBOARD_PORT=5000

# Version string reported by GET /api/health
DASHBOARD_VERSION=2.0.0-m2

# --- R&D pipeline / weekly sync (used by pipeline/cron-weekly-sync.sh) ---

# Linear API key for checking prioritized R&D tasks (optional; skipped if unset)
LINEAR_API_KEY=
